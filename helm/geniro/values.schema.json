{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "api": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" }
          }
        },
        "env": {
          "type": "object",
          "properties": {
            "AUTH_PROVIDER": {
              "type": "string",
              "enum": ["keycloak", "zitadel"]
            }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": { "type": "string" },
                "memory": { "type": "string" }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": { "type": "string" },
                "memory": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "litellm": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "env": {
          "type": "object",
          "properties": {
            "API_URL": { "type": "string" },
            "WEBSITE_URL": { "type": "string" }
          }
        }
      }
    },
    "daytona": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "externalDaytona": {
      "type": "object",
      "properties": {
        "apiUrl": { "type": "string" },
        "apiKey": { "type": "string" }
      }
    },
    "keycloak": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "auth": {
          "type": "object",
          "properties": {
            "adminUser": { "type": "string" },
            "adminPassword": {
              "type": "string",
              "description": "Must be at least 8 characters when keycloak.enabled=true. Enforced by template guards."
            }
          }
        },
        "realm": {
          "type": "object",
          "properties": {
            "seedUser": {
              "type": "object",
              "properties": {
                "password": {
                  "type": "string",
                  "description": "Seed user password for the Keycloak realm admin user. Stored in a ConfigMap — change on first login."
                }
              }
            }
          }
        }
      }
    },
    "zitadel": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "qdrant": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "openrouterApiKey": { "type": "string" },
        "litellmMasterKey": { "type": "string", "minLength": 1 },
        "litellmSaltKey": { "type": "string", "minLength": 1 },
        "githubApp": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "id": { "type": "string" },
            "privateKey": { "type": "string" },
            "clientId": { "type": "string" },
            "clientSecret": { "type": "string" }
          }
        }
      }
    }
  }
}
